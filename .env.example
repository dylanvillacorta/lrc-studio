# Variables para el stack local de pruebas (docker-compose.dev.yml)
# Copia este archivo a .env si deseas personalizar los valores locales.

# IP de enlace en el host (0.0.0.0 permite conexiones desde otros dispositivos en la LAN)
DEV_BIND_IP=0.0.0.0

# Puerto publicado en el host
DEV_PORT=8080

# Metadatos de compilación inyectados en el build de producción local
VITE_SITE_URL=http://localhost:8080
APP_VERSION=0.0.0-dev
APP_COMMIT=local
